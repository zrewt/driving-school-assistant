# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is listed in .gitignore.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only! Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Texting provider: "telnyx" or "twilio" (default twilio) ---
SMS_PROVIDER=telnyx

# --- Telnyx (Portal → API Keys; number from Numbers → My Numbers) ---
TELNYX_API_KEY=your-telnyx-api-key
# The Telnyx number that sends texts, in E.164 format
TELNYX_FROM_NUMBER=+15555550100

# --- Twilio (Console → Account info) — only if SMS_PROVIDER=twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The Twilio number that sends texts, in E.164 format
TWILIO_FROM_NUMBER=+15555550100

# --- Retell AI (Dashboard → Settings → API Keys) ---
RETELL_API_KEY=your-retell-api-key
# Retell signs webhooks with the API key that has the "webhook" badge.
# Paste that key here. If blank, RETELL_API_KEY is used instead.
RETELL_WEBHOOK_SECRET=your-retell-webhook-badge-api-key

# --- App settings ---
# true = log text messages to the terminal instead of sending them
MOCK_SMS=true
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=replace-with-a-long-random-string
# Public URL of the app (http://localhost:3000 locally, your Vercel URL in production)
APP_URL=http://localhost:3000
